# ==============================================================================
# CHANDRA ASRI PACIFIC — MANUFACTURING KNOWLEDGE HUB CONFIGURATION
# ==============================================================================

# LLM Provider Selection: nvidia | deepseek | gemini | openai
LLM_PROVIDER=nvidia

# NVIDIA NIM Configuration (Recommended — Free 1,000 API credits at build.nvidia.com)
# Get your API key at: https://build.nvidia.com (Format: nvapi-...)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# DeepSeek Configuration (DeepSeek Flash / Fast V3 Model: deepseek-chat)
# Get your API key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Google Gemini Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration (Optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Operating Mode: Set to false to allow live API calls, true to force deterministic offline mode
OFFLINE_MODE=false

# LLM Timeout in seconds (default: 35.0 for cloud NIMs)
LLM_TIMEOUT=35.0
