# ==============================================================================
# CHANDRA ASRI PACIFIC — MANUFACTURING KNOWLEDGE HUB CONFIGURATION
# ==============================================================================

# LLM Provider Selection: gemini | deepseek | openai
LLM_PROVIDER=gemini

# Google Gemini Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# DeepSeek Configuration (DeepSeek Flash / Fast V3 Model: deepseek-chat)
# Get your API key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# OpenAI Configuration (Optional)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Operating Mode: Set to false to allow live API calls, true to force deterministic offline mode
OFFLINE_MODE=false

# LLM Timeout in seconds (default: 18.0)
LLM_TIMEOUT=18.0
